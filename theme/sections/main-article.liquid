<div class="page-width" style="max-width:760px;padding-top:40px;">
  <div class="text-center" style="margin-bottom:24px;">
    <p style="color:var(--color-text);font-size:13px;">{{ article.published_at | date: '%d/%m/%Y' }}{% if article.author != blank %} &middot; {{ article.author }}{% endif %}</p>
    <h1>{{ article.title }}</h1>
  </div>
  {%- if article.image -%}
    <img src="{{ article.image | image_url: width: 1200 }}" alt="{{ article.title | escape }}" style="border-radius:var(--radius-card);width:100%;margin-bottom:32px;">
  {%- endif -%}
  <div>{{ article.content }}</div>

  {%- if blog.comments_enabled? -%}
    <div style="margin-top:48px;">
      {%- form 'new_comment', article -%}
        <div class="field">
          <label for="CommentAuthor">Nome</label>
          <input type="text" name="comment[author]" id="CommentAuthor" required>
        </div>
        <div class="field">
          <label for="CommentEmail">E-mail</label>
          <input type="email" name="comment[email]" id="CommentEmail" required>
        </div>
        <div class="field">
          <label for="CommentBody">Comentário</label>
          <textarea name="comment[body]" id="CommentBody" required></textarea>
        </div>
        <button type="submit" class="button">Enviar comentário</button>
      {%- endform -%}
    </div>
  {%- endif -%}
</div>

{% schema %}
{ "name": "Artigo", "settings": [] }
{% endschema %}
