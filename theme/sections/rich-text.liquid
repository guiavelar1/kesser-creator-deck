<div class="section{% if section.settings.background == 'alt' %} section--alt{% endif %}">
  <div class="page-width">
    <div class="rich-text">
      {%- if section.settings.eyebrow != blank -%}
        <span class="section-header__eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2>{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div>{{ section.settings.text }}</div>
      {%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <p style="margin-top:20px;"><a href="{{ section.settings.button_link }}" class="button">{{ section.settings.button_label }}</a></p>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Texto rico",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Texto pequeno"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Feito para a sua pele"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Texto",
      "default": "<p>Descreva aqui a proposta da marca Kesser.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Texto do botão"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Link do botão"
    },
    {
      "type": "select",
      "id": "background",
      "label": "Fundo",
      "options": [
        { "value": "default", "label": "Padrão" },
        { "value": "alt", "label": "Alternativo" }
      ],
      "default": "default"
    }
  ],
  "presets": [
    {
      "name": "Texto rico"
    }
  ]
}
{% endschema %}
