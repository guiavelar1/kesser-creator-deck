<div class="page-width">
  <div class="collection-header">
    <h1>Coleções</h1>
  </div>
  <div class="product-grid product-grid--3">
    {%- for collection in collections -%}
      <a href="{{ collection.url }}" class="card-product">
        <div class="card-product__media">
          {%- if collection.image -%}
            <img src="{{ collection.image | image_url: width: 600 }}" alt="{{ collection.title | escape }}" loading="lazy">
          {%- else -%}
            {{ 'collection-1' | placeholder_svg_tag }}
          {%- endif -%}
        </div>
        <div class="card-product__info">
          <p class="card-product__title">{{ collection.title }}</p>
        </div>
      </a>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{ "name": "Lista de coleções", "settings": [] }
{% endschema %}
