<footer class="site-footer">
  <p class="footer-wordmark">{{ settings.logo_wordmark | default: shop.name }}</p>
  <div class="page-width">
    <div class="footer-grid">
      <div class="footer-brand">
        <h3>{{ 'sections.footer.newsletter_heading' | t }}</h3>
        {%- if section.settings.brand_text != blank -%}
          <p>{{ section.settings.brand_text }}</p>
        {%- endif -%}
        {%- form 'customer', id: 'FooterNewsletterForm' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <div class="footer-newsletter-pill">
            <input type="email" name="contact[email]" placeholder="{{ 'general.newsletter_form.email_placeholder' | t }}" required aria-label="{{ 'general.newsletter_form.email_placeholder' | t }}">
            <button type="submit">{{ 'general.newsletter_form.submit' | t }}</button>
          </div>
          {%- if form.posted_successfully? -%}
            <p style="font-size:12px;margin-top:8px;">{{ 'general.newsletter_form.success' | t }}</p>
          {%- endif -%}
        {%- endform -%}
        <div class="footer-social">
          {%- if settings.social_instagram_link != blank -%}
            <a href="{{ settings.social_instagram_link }}" aria-label="Instagram">{%- render 'icon-instagram' -%}</a>
          {%- endif -%}
          {%- if settings.social_tiktok_link != blank -%}
            <a href="{{ settings.social_tiktok_link }}" aria-label="TikTok">{%- render 'icon-tiktok' -%}</a>
          {%- endif -%}
          {%- if settings.social_facebook_link != blank -%}
            <a href="{{ settings.social_facebook_link }}" aria-label="Facebook">{%- render 'icon-facebook' -%}</a>
          {%- endif -%}
        </div>
      </div>

      {%- for block in section.blocks -%}
        {%- if block.type == 'link_list' -%}
          <div class="footer-col" {{ block.shopify_attributes }}>
            <h3>{{ block.settings.title }}</h3>
            <ul>
              {%- for link in block.settings.menu.links -%}
                <li><a href="{{ link.url }}">{{ link.title }}</a></li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

    <div class="footer-bottom">
      <span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}</span>
      <span>{{ shop.address.country }} &middot; {{ cart.currency.iso_code }}</span>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Rodapé",
  "settings": [
    {
      "type": "textarea",
      "id": "brand_text",
      "label": "Texto do newsletter",
      "default": "Novidades, lançamentos e ofertas exclusivas direto no seu e-mail."
    }
  ],
  "blocks": [
    {
      "type": "link_list",
      "name": "Lista de links",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Título",
          "default": "Institucional"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu",
          "default": "footer"
        }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "link_list", "settings": { "title": "Navegar" } },
      { "type": "link_list", "settings": { "title": "Institucional" } },
      { "type": "link_list", "settings": { "title": "Ajuda" } }
    ]
  }
}
{% endschema %}
