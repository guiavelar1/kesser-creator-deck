<div class="image-with-text{% if section.settings.layout == 'reverse' %} image-with-text--reverse{% endif %}">
  <div class="image-with-text__media">
    {%- if section.settings.image -%}
      <img
        src="{{ section.settings.image | image_url: width: 900 }}"
        alt="{{ section.settings.image.alt | escape }}"
        loading="lazy"
        width="900"
        height="{{ 900 | divided_by: section.settings.image.aspect_ratio }}"
      >
    {%- else -%}
      {{ 'lifestyle-2' | placeholder_svg_tag }}
    {%- endif -%}
  </div>
  <div class="image-with-text__content">
    {%- if section.settings.eyebrow != blank -%}
      <span class="section-header__eyebrow" style="margin-bottom:8px;">{{ section.settings.eyebrow }}</span>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2>{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <div>{{ section.settings.text }}</div>
    {%- endif -%}
    {%- if section.settings.button_label != blank -%}
      <p style="margin-top:16px;"><a href="{{ section.settings.button_link }}" class="button">{{ section.settings.button_label }}</a></p>
    {%- endif -%}
    {%- if section.blocks.size > 0 -%}
      <ul class="image-with-text__links">
        {%- for block in section.blocks -%}
          <li {{ block.shopify_attributes }}>
            {%- if block.settings.link != blank -%}
              <a href="{{ block.settings.link }}">{{ block.settings.title }}</a>
            {%- else -%}
              <span>{{ block.settings.title }}</span>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Imagem com texto",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Imagem"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Posição da imagem",
      "options": [
        { "value": "default", "label": "Esquerda" },
        { "value": "reverse", "label": "Direita" }
      ],
      "default": "default"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Texto pequeno"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "um bálsamo, resultados múltiplos"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Texto",
      "default": "<p>Hidrata, protege e prepara a pele para maquiagem em um único passo.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Texto do botão"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Link do botão"
    }
  ],
  "blocks": [
    {
      "type": "link",
      "name": "Link",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Texto",
          "default": "missão"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Imagem com texto"
    }
  ]
}
{% endschema %}
