<div class="page-width">
  <h1>{{ 'cart.title' | t }}</h1>

  {%- if cart.item_count == 0 -%}
    <div style="padding:60px 0;text-align:center;">
      <p>{{ 'cart.empty' | t }}</p>
      <a href="/collections/all" class="button">{{ 'cart.empty_link' | t }}</a>
    </div>
  {%- else -%}
    {%- form 'cart', cart -%}
      <table class="cart-page-table">
        <thead>
          <tr>
            <th>Produto</th>
            <th>{{ 'cart.quantity' | t }}</th>
            <th>{{ 'cart.subtotal' | t }}</th>
          </tr>
        </thead>
        <tbody>
          {%- for item in cart.items -%}
            <tr>
              <td>
                <div class="cart-page-row__product">
                  <a href="{{ item.url }}" class="cart-page-row__image">
                    {%- if item.image -%}
                      <img src="{{ item.image | image_url: width: 200 }}" alt="{{ item.product.title | escape }}" loading="lazy">
                    {%- endif -%}
                  </a>
                  <div>
                    <a href="{{ item.url }}" class="cart-line__title">{{ item.product.title }}</a>
                    {%- unless item.variant.title == 'Default Title' -%}
                      <div class="cart-line__price">{{ item.variant.title }}</div>
                    {%- endunless -%}
                    <div class="cart-line__price">{{ item.final_price | money }}</div>
                  </div>
                </div>
              </td>
              <td>
                <input type="number" name="updates[{{ item.key }}]" value="{{ item.quantity }}" min="0" style="width:80px;min-height:44px;">
              </td>
              <td>{{ item.final_line_price | money }}</td>
            </tr>
          {%- endfor -%}
        </tbody>
      </table>

      <div style="display:flex;justify-content:flex-end;margin-top:24px;">
        <div style="min-width:280px;">
          <div class="cart-drawer__subtotal">
            <span>{{ 'cart.subtotal' | t }}</span>
            <span>{{ cart.total_price | money }}</span>
          </div>
          <button type="submit" name="update" class="button button--full" style="margin-bottom:10px;">{{ 'cart.update' | t }}</button>
          <button type="submit" name="checkout" class="button button--solid button--full">{{ 'cart.checkout' | t }}</button>
        </div>
      </div>
    {%- endform -%}
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Página do carrinho",
  "settings": []
}
{% endschema %}
