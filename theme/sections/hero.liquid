<div class="page-width">
  <div class="hero">
    <div class="hero__media">
      {%- if section.settings.image -%}
        <img
          src="{{ section.settings.image | image_url: width: 1600 }}"
          alt="{{ section.settings.image.alt | default: section.settings.heading | escape }}"
          width="1600"
          height="{{ 1600 | divided_by: section.settings.image.aspect_ratio }}"
          fetchpriority="high"
        >
      {%- else -%}
        {{ 'lifestyle-1' | placeholder_svg_tag }}
      {%- endif -%}
      <div class="hero__content{% if section.settings.alignment == 'center' %} hero__content--center{% endif %}">
        {%- if section.settings.eyebrow != blank -%}
          <p class="hero__eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h1 class="hero__heading">{{ section.settings.heading }}</h1>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <p class="hero__text">{{ section.settings.text }}</p>
        {%- endif -%}
        <div class="hero__actions">
          {%- if section.settings.button_label != blank -%}
            <a href="{{ section.settings.button_link }}" class="button">{{ section.settings.button_label }}</a>
          {%- endif -%}
          {%- if section.settings.button_label_2 != blank -%}
            <a href="{{ section.settings.button_link_2 }}" class="button button--secondary" style="background:rgba(255,255,255,0.15);color:#fff;border-color:#fff;">{{ section.settings.button_label_2 }}</a>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Imagem"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alinhamento do conteúdo",
      "options": [
        { "value": "start", "label": "Inferior esquerdo" },
        { "value": "center", "label": "Centro" }
      ],
      "default": "start"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Texto pequeno acima do título",
      "default": "Skincare all in one"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Sua rotina de skincare, simplificada"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Texto",
      "default": "Fórmulas vegan e cruelty free feitas para pele radiante, todos os dias."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Texto do botão",
      "default": "Comprar agora"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Link do botão"
    },
    {
      "type": "text",
      "id": "button_label_2",
      "label": "Texto do botão secundário"
    },
    {
      "type": "url",
      "id": "button_link_2",
      "label": "Link do botão secundário"
    }
  ],
  "presets": [
    {
      "name": "Hero"
    }
  ]
}
{% endschema %}
