<div class="section{% if section.settings.background == 'alt' %} section--alt{% endif %}">
  <div class="page-width">
    <div class="section-header">
      {%- if section.settings.eyebrow != blank -%}
        <span class="section-header__eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2>{{ section.settings.heading }}</h2>
      {%- endif -%}
    </div>
    <div class="testimonials-grid">
      {%- for block in section.blocks -%}
        <div class="testimonial-card" {{ block.shopify_attributes }}>
          <div class="testimonial-card__stars" aria-hidden="true">
            {%- for i in (1..5) -%}★{%- endfor -%}
          </div>
          <p>&ldquo;{{ block.settings.quote }}&rdquo;</p>
          <p class="testimonial-card__author">{{ block.settings.author }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Depoimentos",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Texto pequeno",
      "default": "Quem usa, ama"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "O que dizem sobre a Kesser"
    },
    {
      "type": "select",
      "id": "background",
      "label": "Fundo",
      "options": [
        { "value": "default", "label": "Padrão" },
        { "value": "alt", "label": "Alternativo" }
      ],
      "default": "default"
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Depoimento",
      "settings": [
        {
          "type": "textarea",
          "id": "quote",
          "label": "Depoimento",
          "default": "Minha pele nunca esteve tão hidratada e com aparência saudável."
        },
        {
          "type": "text",
          "id": "author",
          "label": "Autor(a)",
          "default": "Cliente Kesser"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Depoimentos",
      "blocks": [
        { "type": "testimonial", "settings": { "quote": "Minha pele nunca esteve tão hidratada. Virou o único produto da minha rotina.", "author": "Ana P." } },
        { "type": "testimonial", "settings": { "quote": "Prático, cheiro leve e resultado rápido. Recomendo demais.", "author": "Carla M." } },
        { "type": "testimonial", "settings": { "quote": "Substituiu 4 produtos da minha nécessaire. Amei!", "author": "Bianca S." } }
      ]
    }
  ]
}
{% endschema %}
