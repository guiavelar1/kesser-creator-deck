<div class="section{% if section.settings.background == 'alt' %} section--alt{% endif %}" id="shopify-section-{{ section.id }}">
  <div class="page-width">
    <div class="section-header">
      {%- if section.settings.eyebrow != blank -%}
        <span class="section-header__eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2>{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <p>{{ section.settings.text }}</p>
      {%- endif -%}
    </div>

    {%- assign collection = collections[section.settings.collection] -%}
    <div class="product-grid product-grid--{{ section.settings.columns }}">
      {%- if collection != blank -%}
        {%- for product in collection.products limit: section.settings.products_to_show -%}
          {%- render 'card-product', product: product -%}
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..section.settings.products_to_show) -%}
          <div class="card-product">
            <div class="card-product__media">{{ 'product-1' | placeholder_svg_tag }}</div>
            <div class="card-product__info">
              <p class="card-product__title">Produto de exemplo</p>
            </div>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>

    {%- if section.settings.show_view_all and collection != blank -%}
      <p class="text-center" style="margin-top:32px;">
        <a href="{{ collection.url }}" class="button button--secondary">{{ 'sections.featured_collection.view_all' | t }}</a>
      </p>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Coleção em destaque",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Texto pequeno",
      "default": "Best sellers"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Mais vendidos"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Texto"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Coleção"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4,
      "label": "Produtos a exibir"
    },
    {
      "type": "select",
      "id": "columns",
      "label": "Colunas (desktop)",
      "options": [
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ],
      "default": "4"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Mostrar botão \"Ver todos\"",
      "default": true
    },
    {
      "type": "select",
      "id": "background",
      "label": "Fundo",
      "options": [
        { "value": "default", "label": "Padrão" },
        { "value": "alt", "label": "Alternativo" }
      ],
      "default": "default"
    }
  ],
  "presets": [
    {
      "name": "Coleção em destaque"
    }
  ]
}
{% endschema %}
